{% extends "@Contao/content_element/_base.html.twig" %}

{% trans_default_domain 'contao_default' %}

{% block content %}
    {% if standalone|default(false) %}
        {#
            Standalone: mark the page before it is painted, so that the body has the
            background of the app in the right theme from the start (same logic as
            getInitialTheme() in class-book.js).
        #}
        {% add "class_book_standalone" to head %}
            <script{{ attrs().setIfExists('nonce', csp_nonce('script-src')) }}>
                (function (root) {
                    var theme = null;
                    try { theme = window.localStorage.getItem('cb-theme'); } catch (error) {}
                    if ('light' !== theme && 'dark' !== theme) {
                        theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                    }
                    root.classList.add('cb-standalone');
                    root.setAttribute('data-cb-theme', theme);
                })(document.documentElement);
            </script>
        {% endadd %}
    {% endif %}
    {% if state == 'backend' %}
        <p>{{ 'MSC.classBook.title'|trans }}</p>
    {% elseif state != 'app' %}
        {#
            Login form in the design of the app. It has the same fields as the login element
            of the Contao core and is handled by the login of Contao: user name and password
            first, then the code if the member uses the two-factor authentication. If the
            element allows it, the card shows the registration form instead (registration.view).
        #}
        {% set view = registration.enabled|default(false) ? registration.view : 'login' %}
        <div class="cb-app cb-login{{ standalone ? ' cb-app--standalone' }}" data-cb-static>
            <div class="cb-login__card">
            {% if view == 'sent' %}
                {# The same message for a new and for a known address, see RegistrationService #}
                <p class="cb-login__brand">{{ 'MSC.classBook.title'|trans }}</p>
                <h2 class="cb-login__title">{{ 'MSC.classBook.registerSentTitle'|trans }}</h2>
                <p class="cb-login__lead">{{ 'MSC.classBook.registerSent'|trans }}</p>
                <p class="cb-login__switch"><a href="{{ registration.login_url }}">{{ 'MSC.classBook.registerBack'|trans }}</a></p>
            {% elseif view == 'form' %}
                {# Registration of a teacher: handled by the controller of the element #}
                <p class="cb-login__brand">{{ 'MSC.classBook.title'|trans }}</p>
                <h2 class="cb-login__title">{{ 'MSC.classBook.registerTitle'|trans }}</h2>
                <p class="cb-login__lead">{{ 'MSC.classBook.registerLead'|trans }}</p>

                {% if registration.errors.form is defined %}
                    <p class="cb-message cb-message--error" role="alert">{{ ('MSC.classBook.registerError.' ~ registration.errors.form)|trans }}</p>
                {% endif %}

                <form class="cb-login__form" id="{{ registration.form_id }}" method="post" action="{{ registration.register_url }}" novalidate>
                    <input type="hidden" name="FORM_SUBMIT" value="{{ registration.form_id }}">
                    <input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}">

                    {% for field in [
                        {name: 'firstname', label: 'registerFirstname', type: 'text', autocomplete: 'given-name'},
                        {name: 'lastname', label: 'registerLastname', type: 'text', autocomplete: 'family-name'},
                        {name: 'email', label: 'registerEmail', type: 'email', autocomplete: 'email'},
                        {name: 'password', label: 'registerPassword', type: 'password', autocomplete: 'new-password'},
                        {name: 'passwordConfirm', label: 'registerPasswordConfirm', type: 'password', autocomplete: 'new-password'},
                    ] %}
                        {% set error = registration.errors[field.name]|default(null) %}
                        <div class="cb-field{{ error ? ' cb-field--error' }}">
                            <label for="cb-register-{{ field.name }}">{{ ('MSC.classBook.' ~ field.label)|trans }}</label>
                            <input type="{{ field.type }}" name="{{ field.name }}" id="cb-register-{{ field.name }}" value="{{ registration.values[field.name]|default('') }}" autocomplete="{{ field.autocomplete }}" autocapitalize="{{ field.type == 'text' ? 'words' : 'off' }}" required{% if field.type == 'password' %} minlength="{{ registration.min_password_length }}"{% endif %}{% if error %} aria-invalid="true" aria-describedby="cb-register-{{ field.name }}-error"{% endif %}>
                            {% if error %}
                                <span class="cb-field__error" id="cb-register-{{ field.name }}-error">{{ ('MSC.classBook.registerError.' ~ error)|trans }}</span>
                            {% elseif field.name == 'password' %}
                                <span class="cb-field__hint">{{ 'MSC.classBook.registerPasswordHint'|trans([registration.min_password_length]) }}</span>
                            {% endif %}
                        </div>
                    {% endfor %}

                    {# Not for people: a filled in field marks a bot #}
                    <div class="cb-login__trap" aria-hidden="true">
                        <label for="cb-register-{{ registration.honeypot }}">Website</label>
                        <input type="text" name="{{ registration.honeypot }}" id="cb-register-{{ registration.honeypot }}" value="" tabindex="-1" autocomplete="off">
                    </div>

                    <div class="cb-login__actions">
                        <button type="submit" class="cb-button cb-button--primary">{{ 'MSC.classBook.registerSubmit'|trans }}</button>
                    </div>
                </form>

                <p class="cb-login__switch"><a href="{{ registration.login_url }}">{{ 'MSC.classBook.registerBack'|trans }}</a></p>
            {% else %}
                <p class="cb-login__brand">{{ 'MSC.classBook.title'|trans }}</p>
                <h2 class="cb-login__title">{{ (state == 'two_factor' ? 'MSC.classBook.twoFactorTitle' : 'MSC.classBook.loginWelcome')|trans }}</h2>
                <p class="cb-login__lead">{{ (state == 'two_factor' ? 'MSC.classBook.twoFactorLoginLead' : 'MSC.classBook.loginLead')|trans }}</p>

                {% if view == 'activated' %}
                    <p class="cb-message cb-message--success" role="status">{{ 'MSC.classBook.registerActivated'|trans }}</p>
                {% elseif view == 'invalid' %}
                    <p class="cb-message cb-message--error" role="alert">{{ 'MSC.classBook.registerInvalid'|trans }}</p>
                {% endif %}

                {% if login.message %}
                    <p class="cb-message cb-message--error" role="alert">{{ login.message|trans }}</p>
                {% endif %}

                <form class="cb-login__form" id="{{ login.form_id }}" method="post">
                    <input type="hidden" name="FORM_SUBMIT" value="{{ login.form_id }}">
                    <input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}">
                    <input type="hidden" name="_target_path" value="{{ login.target_path }}">
                    <input type="hidden" name="_always_use_target_path" value="1">
                    <input type="hidden" name="{{ login.marker }}" value="1">

                    {% if state == 'two_factor' %}
                        <div class="cb-field">
                            <label for="cb-login-verify">{{ 'MSC.twoFactorVerification'|trans }}</label>
                            <input type="text" name="verify" id="cb-login-verify" value="" inputmode="numeric" autocapitalize="off" autocomplete="one-time-code" required autofocus>
                        </div>
                        <label class="cb-check"><input type="checkbox" name="trusted" value="1"> {{ 'MSC.twoFactorTrustDevice'|trans }}</label>
                        <div class="cb-login__actions">
                            <button type="submit" class="cb-button cb-button--primary">{{ 'MSC.continue'|trans }}</button>
                            <a class="cb-button" href="{{ login.logout_url }}">{{ 'MSC.cancelBT'|trans }}</a>
                        </div>
                    {% else %}
                        <div class="cb-field">
                            <label for="cb-login-username">{{ 'MSC.classBook.loginUsername'|trans }}</label>
                            <input type="text" name="username" id="cb-login-username" value="{{ login.username }}" autocapitalize="off" autocomplete="username" required{{ login.username ? '' : ' autofocus' }}>
                        </div>
                        <div class="cb-field">
                            <label for="cb-login-password">{{ 'MSC.password.0'|trans }}</label>
                            <input type="password" name="password" id="cb-login-password" value="" autocomplete="current-password" required{{ login.username ? ' autofocus' : '' }}>
                        </div>
                        <div class="cb-login__actions">
                            <button type="submit" class="cb-button cb-button--primary">{{ 'MSC.login'|trans }}</button>
                        </div>
                    {% endif %}
                </form>

                {% if registration.enabled|default(false) %}
                    <p class="cb-login__switch"><a href="{{ registration.register_url }}">{{ 'MSC.classBook.registerLink'|trans }}</a></p>
                {% endif %}
            {% endif %}
            </div>
        </div>

        {% add "class_book_css" to head %}
            <link rel="stylesheet" href="{{ asset('css/class-book.css', 'markocupic_contao_class_book') }}">
        {% endadd %}
        {% add "class_book_js" to body %}
            <script src="{{ asset('js/class-book.js', 'markocupic_contao_class_book') }}"></script>
        {% endadd %}
    {% else %}
        {#
            Vue template, see assets/js/class-book.js. Vue uses the delimiters [[ ]],
            so an expression must not contain two closing square brackets in a row.
            The texts come from the language files (MSC.classBook) and are available as "labels".
        #}
        <div class="cb-app{{ standalone ? ' cb-app--standalone' }}" data-class-book="{{ app|json_encode }}" v-cloak>
            <header class="cb-header">
                <div class="cb-header__title">
                    <strong>[[ labels.title ]]</strong>
                    <span class="cb-header__member">[[ config.member.firstname ]] [[ config.member.lastname ]]</span>
                </div>

                <nav class="cb-tabs">
                    <button type="button" class="cb-tab" :class="{'cb-tab--active': view === 'week'}" @click="showWeek()">[[ labels.viewWeek ]]</button>
                    <button type="button" class="cb-tab" :class="{'cb-tab--active': view === 'day'}" @click="showDay()">[[ labels.viewDay ]]</button>
                    <button type="button" class="cb-tab" :class="{'cb-tab--active': view === 'groups'}" @click="showGroups()">[[ labels.viewGroups ]]</button>
                    <button type="button" class="cb-tab" :class="{'cb-tab--active': view === 'seating'}" @click="showSeating()">[[ labels.viewSeating ]]</button>
                    <button type="button" class="cb-tab" :class="{'cb-tab--active': view === 'settings'}" @click="showSettings()">[[ labels.viewSettings ]]</button>
                    <button type="button" class="cb-theme" @click="toggleTheme()" :title="themeLabel" :aria-label="themeLabel">
                        <cb-icon :name="theme === 'dark' ? 'sun' : 'moon'"></cb-icon>
                    </button>
                    {# User menu: security settings and log out #}
                    <div class="cb-user">
                        <button type="button" class="cb-theme" @click="userMenu = !userMenu" :title="labels.userMenu" :aria-label="labels.userMenu" aria-haspopup="true" :aria-expanded="userMenu ? 'true' : 'false'">
                            <cb-icon name="user"></cb-icon>
                        </button>
                        <div class="cb-user__menu" v-if="userMenu">
                            <p class="cb-user__name">[[ config.member.firstname ]] [[ config.member.lastname ]]</p>
                            <button type="button" class="cb-user__item" @click="openSecurity()"><cb-icon name="security"></cb-icon> [[ labels.security ]]</button>
                            <a class="cb-user__item" :href="config.urls.logout"><cb-icon name="logout"></cb-icon> [[ labels.logout ]]</a>
                        </div>
                    </div>
                </nav>
            </header>

            <p class="cb-message cb-message--error" v-if="error" role="alert">[[ errorMessage ]]</p>

            {# Week view and day view #}
            <section class="cb-view" v-if="view === 'week' || view === 'day'" :class="{'cb-view--important': week && importantItems.length > 0}">
                <div class="cb-top">
                    <div class="cb-top__main">
                        <p class="cb-notice" v-if="week && openCount > 0">
                            [[ labels.openNotice ]] <strong>[[ openCount ]]</strong>
                            <button type="button" class="cb-button" @click="showOpenEntries()">[[ labels.showOpen ]]</button>
                        </p>

                        <nav class="cb-nav" v-if="week && view === 'week'">
                            <button type="button" class="cb-button" @click="shiftWeeks(-4)" :disabled="loading" :title="labels.fourWeeksBack" :aria-label="labels.fourWeeksBack">&laquo;</button>
                            <button type="button" class="cb-button" @click="loadWeek(week.previous)" :disabled="loading" :title="labels.previousWeek" :aria-label="labels.previousWeek">&lsaquo;</button>
                            <button type="button" class="cb-button" @click="loadWeek(null)" :disabled="loading">[[ labels.today ]]</button>
                            <button type="button" class="cb-button" @click="loadWeek(week.next)" :disabled="loading" :title="labels.nextWeek" :aria-label="labels.nextWeek">&rsaquo;</button>
                            <button type="button" class="cb-button" @click="shiftWeeks(4)" :disabled="loading" :title="labels.fourWeeksForward" :aria-label="labels.fourWeeksForward">&raquo;</button>
                            <input type="date" class="cb-nav__date" :value="week.start" @change="jumpToDate($event.target.value)" :title="labels.jumpToDate" :aria-label="labels.jumpToDate">
                            <button type="button" class="cb-button cb-nav__weekend" :class="{'cb-nav__weekend--on': weekend}" @click="toggleWeekend()" :aria-pressed="weekend ? 'true' : 'false'" :title="weekend ? labels.weekendHide : labels.weekendShow">
                                [[ labels.weekend ]]
                                <span class="cb-nav__count" v-if="!weekend && weekendCount > 0" :title="labels.weekendEntries">[[ weekendCount ]]</span>
                            </button>
                            <span class="cb-nav__label">[[ labels.calendarWeek ]] [[ week.week ]] &middot; [[ weekRange ]]</span>
                        </nav>

                        <nav class="cb-nav" v-if="week && view === 'day'">
                            <button type="button" class="cb-button" @click="shiftDay(-7)" :disabled="loading" :title="labels.oneWeekBack" :aria-label="labels.oneWeekBack">&laquo;</button>
                            <button type="button" class="cb-button" @click="shiftDay(-1)" :disabled="loading" :title="labels.previousDay" :aria-label="labels.previousDay">&lsaquo;</button>
                            <button type="button" class="cb-button" @click="loadDay(week.today)" :disabled="loading">[[ labels.today ]]</button>
                            <button type="button" class="cb-button" @click="shiftDay(1)" :disabled="loading" :title="labels.nextDay" :aria-label="labels.nextDay">&rsaquo;</button>
                            <button type="button" class="cb-button" @click="shiftDay(7)" :disabled="loading" :title="labels.oneWeekForward" :aria-label="labels.oneWeekForward">&raquo;</button>
                            <input type="date" class="cb-nav__date" :value="day" @change="jumpToDate($event.target.value)" :title="labels.jumpToDate" :aria-label="labels.jumpToDate">
                            <span class="cb-nav__label">[[ formatLongDate(day) ]]</span>
                        </nav>
                    </div>

                    {# Box: important entries and the birthdays of the next days #}
                    <aside class="cb-important" v-if="week && importantItems.length">
                        <strong class="cb-important__title">[[ labels.importantTitle ]]</strong>
                        <ul>
                            <li v-for="item in importantItems" :key="item.key" :class="{'cb-important__today': item.days === 0}">
                                <span class="cb-important__when">[[ item.when ]]</span>
                                <button type="button" class="cb-important__text" v-if="item.entry" @click="openEntry(item.entry)" :title="labels.editEntry">[[ item.text ]]</button>
                                <span class="cb-important__text" v-else>[[ item.text ]]</span>
                            </li>
                        </ul>
                    </aside>
                </div>

                <p class="cb-message" v-if="loading && !week">[[ labels.loading ]]</p>

                {# Week view #}
                <div v-if="week && view === 'week'">
                    <div class="cb-scroll">
                        <table class="cb-timetable" :class="{'cb-timetable--loading': loading}">
                            <thead>
                                <tr>
                                    <th class="cb-timetable__period"></th>
                                    <th v-for="day in weekDays" :key="day.date" :class="{'cb-timetable__today': day.isToday}">
                                        <button type="button" class="cb-day__link" @click="loadDay(day.date)" :title="labels.viewDay">
                                            <span class="cb-day__name">[[ formatWeekday(day.date) ]]</span>
                                            <span class="cb-day__date">[[ formatShortDate(day.date) ]]</span>
                                        </button>
                                        <span class="cb-day__holiday" v-if="day.holiday">[[ day.holiday ]]</span>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="cb-timetable__dayrow">
                                    <th class="cb-timetable__period"><strong>[[ labels.dayRow ]]</strong></th>
                                    <td v-for="cell in dayRow" :key="cell.day.date" :class="{'cb-timetable__today': cell.day.isToday, 'cb-timetable__holiday': cell.day.holiday, 'cb-drop': isDropSlot(cell.day.date, 0)}" :data-cb-slot-date="cell.day.date" data-cb-slot-period="0" @dragover="onDragOverSlot(cell.day.date, 0, $event)" @drop.prevent="onDrop()">
                                        <p class="cb-birthday" v-for="birthday in cell.birthdays" :key="birthday.student">[[ birthdayText(birthday) ]]</p>
                                        <ul class="cb-entries" v-if="cell.entries.length">
                                            <li class="cb-entry" v-for="entry in cell.entries" :key="entry.id" :class="entryClass(entry)" :data-cb-entry="entry.id" draggable="true" @touchstart.passive="onTouchStart(entry, $event)" @dragstart="onDragStart(entry, $event)" @dragend="onDragEnd()" @dragover.prevent.stop="onDragOverEntry(entry, $event)">
                                                <input type="checkbox" v-if="'task' === entry.type" :checked="entry.done" @change="toggleDone(entry)" :aria-label="labels.fields.done" :title="labels.fields.done">
                                                <span class="cb-entry__text" role="button" tabindex="0" @click="openEntry(entry)" @keydown.enter="openEntry(entry)" :title="labels.editEntry">
                                                    <span class="cb-entry__time" v-if="entry.entryTime">[[ entry.entryTime ]]</span>
                                                    [[ entry.content ]]
                                                    <span class="cb-entry__location" v-if="entry.location"><cb-icon name="location"></cb-icon> [[ entry.location ]]</span>
                                                </span>
                                                <button type="button" class="cb-entry__copy" @click="copyEntry(entry)" :title="labels.copyEntry" :aria-label="labels.copyEntry">
                                                    <cb-icon name="copy"></cb-icon>
                                                </button>
                                            </li>
                                        </ul>
                                        <button type="button" class="cb-add" @click="newEntry(cell.day.date, null)" :title="labels.addEntry" :aria-label="labels.addEntry">+</button>
                                    </td>
                                </tr>
                                <tr v-for="row in weekGrid" :key="row.period.id">
                                    <th class="cb-timetable__period">
                                        <strong>[[ row.period.number ]]</strong>
                                        <span>[[ row.period.startTime ]]&ndash;[[ row.period.endTime ]]</span>
                                    </th>
                                    <td v-for="cell in row.cells" :key="cell.day.date" :class="{'cb-timetable__today': cell.day.isToday, 'cb-timetable__holiday': cell.day.holiday, 'cb-drop': isDropSlot(cell.day.date, row.period.id)}" :data-cb-slot-date="cell.day.date" :data-cb-slot-period="row.period.id" @dragover="onDragOverSlot(cell.day.date, row.period.id, $event)" @drop.prevent="onDrop()">
                                        <div class="cb-lesson" v-if="cell.lesson" :style="cell.lesson.style" :title="cell.lesson.tooltip">
                                            <strong>[[ cell.lesson.shortTitle ]]</strong>
                                        </div>
                                        <ul class="cb-entries" v-if="cell.entries.length">
                                            <li class="cb-entry" v-for="entry in cell.entries" :key="entry.id" :class="entryClass(entry)" :data-cb-entry="entry.id" draggable="true" @touchstart.passive="onTouchStart(entry, $event)" @dragstart="onDragStart(entry, $event)" @dragend="onDragEnd()" @dragover.prevent.stop="onDragOverEntry(entry, $event)">
                                                <input type="checkbox" v-if="'task' === entry.type" :checked="entry.done" @change="toggleDone(entry)" :aria-label="labels.fields.done" :title="labels.fields.done">
                                                <span class="cb-entry__text" role="button" tabindex="0" @click="openEntry(entry)" @keydown.enter="openEntry(entry)" :title="labels.editEntry">
                                                    <span class="cb-entry__time" v-if="entry.entryTime">[[ entry.entryTime ]]</span>
                                                    [[ entry.content ]]
                                                    <span class="cb-entry__location" v-if="entry.location"><cb-icon name="location"></cb-icon> [[ entry.location ]]</span>
                                                </span>
                                                <button type="button" class="cb-entry__copy" @click="copyEntry(entry)" :title="labels.copyEntry" :aria-label="labels.copyEntry">
                                                    <cb-icon name="copy"></cb-icon>
                                                </button>
                                            </li>
                                        </ul>
                                        <button type="button" class="cb-add" @click="newEntry(cell.day.date, row.period.id)" :title="labels.addEntry" :aria-label="labels.addEntry">+</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <p class="cb-message" v-if="!timetable.periods.length">[[ labels.noPeriods ]]</p>
                    <p class="cb-message" v-else-if="!weekHasLessons">[[ labels.noTimetable ]]</p>
                </div>

                {#
                    Day view: the whole day (holiday, birthdays, entries without a period) and all periods.
                    On large screens the whole day is placed to the right of the periods.
                #}
                <div class="cb-daylist" v-if="week && view === 'day' && dayData" :class="{'cb-timetable--loading': loading}">
                    <div class="cb-daylist__side">
                        <p class="cb-daylist__holiday" v-if="dayData.holiday">[[ labels.holiday ]]: [[ dayData.holiday ]]</p>
                        <p class="cb-birthday" v-for="birthday in dayData.birthdays" :key="birthday.student">[[ birthdayText(birthday) ]]</p>

                        <div class="cb-slotcard cb-slotcard--day" :class="{'cb-drop': isDropSlot(day, 0)}" :data-cb-slot-date="day" data-cb-slot-period="0" @dragover="onDragOverSlot(day, 0, $event)" @drop.prevent="onDrop()">
                            <div class="cb-slotcard__head">
                                <span class="cb-slotcard__time"><strong>[[ labels.wholeDay ]]</strong></span>
                                <button type="button" class="cb-button cb-slotcard__add" @click="newEntry(day, null)" :title="labels.addEntry" :aria-label="labels.addEntry">+</button>
                            </div>
                            <ul class="cb-entries" v-if="dayData.wholeDay.entries.length">
                                <li class="cb-entry" v-for="entry in dayData.wholeDay.entries" :key="entry.id" :class="entryClass(entry)" :data-cb-entry="entry.id" draggable="true" @touchstart.passive="onTouchStart(entry, $event)" @dragstart="onDragStart(entry, $event)" @dragend="onDragEnd()" @dragover.prevent.stop="onDragOverEntry(entry, $event)">
                                    <input type="checkbox" v-if="'task' === entry.type" :checked="entry.done" @change="toggleDone(entry)" :aria-label="labels.fields.done" :title="labels.fields.done">
                                    <span class="cb-entry__text" role="button" tabindex="0" @click="openEntry(entry)" @keydown.enter="openEntry(entry)" :title="labels.editEntry">
                                        <span class="cb-entry__time" v-if="entry.entryTime">[[ entry.entryTime ]]</span>
                                        [[ entry.content ]]
                                        <span class="cb-entry__location" v-if="entry.location"><cb-icon name="location"></cb-icon> [[ entry.location ]]</span>
                                    </span>
                                    <button type="button" class="cb-entry__copy" @click="copyEntry(entry)" :title="labels.copyEntry" :aria-label="labels.copyEntry">
                                        <cb-icon name="copy"></cb-icon>
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="cb-daylist__periods">
                        <div class="cb-slotcard" v-for="slot in dayData.periods" :key="slot.key" :class="{'cb-slotcard--empty': slot.empty, 'cb-drop': isDropSlot(day, slot.periodId)}" :data-cb-slot-date="day" :data-cb-slot-period="slot.periodId" @dragover="onDragOverSlot(day, slot.periodId, $event)" @drop.prevent="onDrop()">
                            <div class="cb-slotcard__head">
                                <span class="cb-slotcard__time">
                                    <strong>[[ slot.title ]]</strong>
                                    <span>[[ slot.time ]]</span>
                                </span>
                                <span class="cb-lesson" v-if="slot.lesson" :style="slot.lesson.style">
                                    <strong>[[ slot.lesson.title ]]</strong>
                                    <span>[[ slot.lesson.details ]]</span>
                                </span>
                                <button type="button" class="cb-button cb-slotcard__add" @click="newEntry(day, slot.periodId)" :title="labels.addEntry" :aria-label="labels.addEntry">+</button>
                            </div>
                            <ul class="cb-entries" v-if="slot.entries.length">
                                <li class="cb-entry" v-for="entry in slot.entries" :key="entry.id" :class="entryClass(entry)" :data-cb-entry="entry.id" draggable="true" @touchstart.passive="onTouchStart(entry, $event)" @dragstart="onDragStart(entry, $event)" @dragend="onDragEnd()" @dragover.prevent.stop="onDragOverEntry(entry, $event)">
                                    <input type="checkbox" v-if="'task' === entry.type" :checked="entry.done" @change="toggleDone(entry)" :aria-label="labels.fields.done" :title="labels.fields.done">
                                    <span class="cb-entry__text" role="button" tabindex="0" @click="openEntry(entry)" @keydown.enter="openEntry(entry)" :title="labels.editEntry">
                                        <span class="cb-entry__time" v-if="entry.entryTime">[[ entry.entryTime ]]</span>
                                        [[ entry.content ]]
                                        <span class="cb-entry__location" v-if="entry.location"><cb-icon name="location"></cb-icon> [[ entry.location ]]</span>
                                    </span>
                                    <button type="button" class="cb-entry__copy" @click="copyEntry(entry)" :title="labels.copyEntry" :aria-label="labels.copyEntry">
                                        <cb-icon name="copy"></cb-icon>
                                    </button>
                                </li>
                            </ul>
                        </div>

                        <p class="cb-message" v-if="!timetable.periods.length">[[ labels.noPeriods ]]</p>
                    </div>
                </div>
            </section>

            {# Random groups of a class or learning group. Nothing is saved, absent students are only deselected. #}
            <section class="cb-view" v-if="view === 'groups'">
                <p class="cb-message" v-if="loading && !master">[[ labels.loading ]]</p>

                <div class="cb-groups" v-if="master">
                    <p class="cb-message" v-if="!master.data.group.length">[[ labels.groupsNoGroups ]]</p>

                    <form class="cb-form" v-else @submit.prevent="makeGroups()" novalidate>
                        <p class="cb-form__title"><strong>[[ labels.groupsTitle ]]</strong></p>
                        <div class="cb-field">
                            <label for="cb-groups-group">[[ labels.fields.learningGroup ]]</label>
                            <select id="cb-groups-group" v-model="groupTool.groupId" @change="resetGroups()">
                                <option value="">[[ labels.pleaseSelect ]]</option>
                                <option v-for="group in master.data.group" :key="group.id" :value="group.id">[[ group.title ]]</option>
                            </select>
                        </div>
                        <div class="cb-field">
                            <label for="cb-groups-mode">[[ labels.groupsMode ]]</label>
                            <select id="cb-groups-mode" v-model="groupTool.mode" @change="groupTool.result = null">
                                <option value="count">[[ labels.groupsModeCount ]]</option>
                                <option value="size">[[ labels.groupsModeSize ]]</option>
                            </select>
                        </div>
                        <div class="cb-field">
                            <label for="cb-groups-value">[[ groupTool.mode === 'count' ? labels.groupsModeCount : labels.groupsModeSize ]]</label>
                            <input id="cb-groups-value" type="number" min="1" max="40" v-model.number="groupTool.value" @input="groupTool.result = null">
                        </div>

                        <div class="cb-groups__students" v-if="groupTool.groupId">
                            <p class="cb-message" v-if="!groupStudents.length">[[ labels.groupsNoStudents ]]</p>
                            <div v-else>
                                <p class="cb-groups__present">
                                    <strong>[[ labels.groupsPresent ]]: [[ presentCountLabel ]]</strong>
                                    <button type="button" class="cb-button" @click="setAllPresent(true)">[[ labels.groupsAll ]]</button>
                                    <button type="button" class="cb-button" @click="setAllPresent(false)">[[ labels.groupsNone ]]</button>
                                </p>
                                <p class="cb-field__hint">[[ labels.groupsHint ]]</p>
                                <div class="cb-checkboxes cb-groups__list">
                                    <label v-for="student in groupStudents" :key="student.id" :class="{'cb-groups__absent': groupTool.absent[student.id]}">
                                        <input type="checkbox" :checked="!groupTool.absent[student.id]" @change="togglePresent(student)"> [[ student.firstname ]] [[ student.lastname ]]
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="cb-form__actions">
                            <button type="submit" class="cb-button cb-button--primary" :disabled="!presentStudents.length">[[ groupTool.result ? labels.groupsShuffle : labels.groupsMake ]]</button>
                        </div>
                    </form>

                    <div v-if="groupTool.result">
                        <div class="cb-groups__export">
                            <button type="button" class="cb-button" @click="exportGroupsDocx()">[[ labels.groupsExportWord ]]</button>
                            <button type="button" class="cb-button" @click="printGroups()">[[ labels.groupsExportPdf ]]</button>
                        </div>

                        {# The sheet is what gets printed #}
                        <div class="cb-groups__sheet" aria-live="polite">
                            <p class="cb-groups__sheet-title"><strong>[[ groupSheet.title ]]</strong> <span>[[ groupSheet.date ]]</span></p>
                            <div class="cb-groups__result">
                                <div class="cb-groups__card" v-for="(members, index) in groupTool.result" :key="index">
                                    <strong>[[ labels.groupsGroup ]] [[ index + 1 ]]</strong>
                                    <ul>
                                        <li v-for="student in members" :key="student.id">[[ student.firstname ]] [[ student.lastname ]]</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            {# Seating plan of a class or learning group in its classroom #}
            <section class="cb-view" v-if="view === 'seating'">
                <p class="cb-message" v-if="loading && !master">[[ labels.loading ]]</p>

                <div class="cb-seating" v-if="master">
                    <p class="cb-message" v-if="!master.data.group.length">[[ labels.groupsNoGroups ]]</p>

                    <div v-else>
                        <div class="cb-form">
                            <p class="cb-form__title"><strong>[[ labels.seatingTitle ]]</strong></p>
                            <div class="cb-field">
                                <label for="cb-seating-group">[[ labels.fields.learningGroup ]]</label>
                                <select id="cb-seating-group" v-model="seatTool.groupId" @change="loadSeating()">
                                    <option value="">[[ labels.pleaseSelect ]]</option>
                                    <option v-for="group in master.data.group" :key="group.id" :value="group.id">[[ group.title ]]</option>
                                </select>
                            </div>
                            <label class="cb-check cb-seating__mix"><input type="checkbox" v-model="seatTool.mix"> [[ labels.seatingMix ]]</label>
                        </div>

                        <div v-if="seatGroup">
                            <p class="cb-message" v-if="!seatRoom">[[ labels.seatingNoRoom ]]</p>
                            <p class="cb-message" v-else-if="!seatDesks.length">[[ labels.seatingNoDesks ]]</p>
                            <p class="cb-message" v-else-if="!seatStudents.length">[[ labels.groupsNoStudents ]]</p>

                            <div v-else>
                                <div class="cb-seating__actions">
                                    <button type="button" class="cb-button cb-button--primary" @click="drawSeats()">[[ labels.seatingDraw ]]</button>
                                    <button type="button" class="cb-button" @click="clearSeats()">[[ labels.seatingClear ]]</button>
                                    <button type="button" class="cb-button" @click="saveSeating()" :disabled="loading || !seatTool.dirty">[[ labels.save ]]</button>
                                    <button type="button" class="cb-button" @click="printSeating()">[[ labels.groupsExportPdf ]]</button>
                                    <span class="cb-seating__state" v-if="seatTool.dirty" role="status">[[ labels.seatingUnsaved ]]</span>
                                    <span class="cb-seating__state cb-seating__state--saved" v-else-if="seatTool.saved" role="status">[[ labels.seatingSaved ]]</span>
                                </div>

                                <p class="cb-field__hint">[[ seatCountLabel ]]. [[ labels.seatingHint ]]</p>
                                <p class="cb-field__hint" v-if="seatTool.mix && seatWithoutGender > 0">[[ labels.seatingNoGender ]] [[ seatWithoutGender ]]</p>

                                {# The sheet is what gets printed #}
                                <div class="cb-seating__sheet">
                                    <p class="cb-groups__sheet-title"><strong>[[ seatSheet.title ]]</strong> <span>[[ seatSheet.room ]] &middot; [[ seatSheet.date ]]</span></p>
                                    <div class="cb-room">
                                    <div class="cb-room__board">[[ labels.roomBoard ]]</div>
                                    <div class="cb-room__area">
                                        <div class="cb-desk" v-for="desk in seatDesks" :key="desk.id" :class="'cb-desk--' + desk.type" :style="desk.style">
                                            <span class="cb-desk__label" v-if="desk.type === 'teacher'">[[ deskLabel('teacher') ]]</span>
                                            {# A span, because Firefox does not start a drag from a button #}
                                            <span class="cb-seat" v-for="seat in desk.seats" :key="seat.key" role="button" tabindex="0" :style="seat.style" :class="seatClass(seat)" :title="seatLabel(seat)" :aria-label="seatLabel(seat)" :draggable="seat.student ? 'true' : 'false'" @click="onSeatClick(seat)" @keydown.enter.prevent="onSeatClick(seat)" @dragstart="onStudentDragStart($event, seat.student)" @dragover.prevent @drop.prevent="onSeatDrop(seat)">
                                                <strong v-if="seat.student">[[ seat.student.firstname ]]</strong>
                                                <span v-if="seat.student">[[ seat.student.lastname ]]</span>
                                                <span class="cb-seat__blocked" v-if="seat.blocked" aria-hidden="true">&times;</span>
                                                <span class="cb-seat__pin" v-if="seat.student" role="button" :title="seat.fixed ? labels.seatingUnfix : labels.seatingFix" :aria-label="seat.fixed ? labels.seatingUnfix : labels.seatingFix" :aria-pressed="seat.fixed ? 'true' : 'false'" @click.stop="toggleFixed(seat)">
                                                    <cb-icon name="pin"></cb-icon>
                                                </span>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                </div>

                                <div class="cb-seating__unseated" @dragover.prevent @drop.prevent="onUnseatedDrop()">
                                    <strong>[[ labels.seatingUnseated ]]</strong>
                                    <span class="cb-seating__student" v-for="student in seatUnseated" :key="student.id" role="button" tabindex="0" draggable="true" :class="{'cb-seating__student--picked': seatTool.picked === student.id}" @click="pickStudent(student)" @keydown.enter.prevent="pickStudent(student)" @dragstart="onStudentDragStart($event, student)">[[ student.firstname ]] [[ student.lastname ]]</span>
                                    <span class="cb-field__hint" v-if="!seatUnseated.length">[[ labels.seatingUnseatedHint ]]</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            {# Settings: master data #}
            <section class="cb-view" v-if="view === 'settings'">
                <nav class="cb-subtabs" v-if="master">
                    <button type="button" class="cb-subtab" v-for="name in resourceNames" :key="name" :class="{'cb-subtab--active': name === resource}" @click="selectResource(name)">[[ labels.resources[name] ]]</button>
                    <button type="button" class="cb-subtab" :class="{'cb-subtab--active': resource === 'lesson'}" @click="selectResource('lesson')">[[ labels.timetable ]]</button>
                    <button type="button" class="cb-subtab" :class="{'cb-subtab--active': resource === 'security'}" @click="selectResource('security')">[[ labels.security ]]</button>
                </nav>

                {# Security: two-factor authentication of the member #}
                <div class="cb-security" v-if="master && resource === 'security'">
                    <p class="cb-message" v-if="!security.status">[[ labels.loading ]]</p>

                    <div v-else>
                        <p class="cb-form__title"><strong>[[ labels.twoFactorTitle ]]</strong></p>
                        <p class="cb-security__state" :class="{'cb-security__state--on': security.status.enabled}">[[ security.status.enabled ? labels.twoFactorEnabled : labels.twoFactorDisabled ]]</p>

                        {# Not enabled #}
                        <div v-if="!security.status.enabled && !security.setup">
                            <p class="cb-security__text">[[ labels.twoFactorExplain ]]</p>
                            <button type="button" class="cb-button cb-button--primary" @click="startTwoFactor()" :disabled="loading">[[ labels.twoFactorStart ]]</button>
                        </div>

                        {# Setup: scan the QR code, then confirm with a code #}
                        <form class="cb-security__setup" v-if="!security.status.enabled && security.setup" @submit.prevent="enableTwoFactor()">
                            <div class="cb-security__step">
                                <p><strong>1.</strong> [[ labels.twoFactorScan ]]</p>
                                <img class="cb-security__qr" :src="security.setup.image" alt="" width="180" height="180">
                                <p class="cb-field__hint">[[ labels.twoFactorSecret ]]</p>
                                <code class="cb-security__secret">[[ security.setup.secret ]]</code>
                            </div>
                            <div class="cb-security__step">
                                <p><strong>2.</strong> [[ labels.twoFactorConfirm ]]</p>
                                <div class="cb-field" :class="{'cb-field--error': security.invalid}">
                                    <label for="cb-two-factor-code">[[ labels.twoFactorCode ]]</label>
                                    <input type="text" id="cb-two-factor-code" v-model="security.code" inputmode="numeric" autocomplete="one-time-code" autocapitalize="off" required>
                                    <span class="cb-field__error" v-if="security.invalid">[[ labels.twoFactorInvalid ]]</span>
                                </div>
                                <div class="cb-form__actions">
                                    <button type="submit" class="cb-button cb-button--primary" :disabled="loading">[[ labels.twoFactorEnable ]]</button>
                                    <button type="button" class="cb-button" @click="security.setup = null">[[ labels.cancel ]]</button>
                                </div>
                            </div>
                        </form>

                        {# Enabled: backup codes and disable #}
                        <div v-if="security.status.enabled">
                            <div class="cb-security__step">
                                <p><strong>[[ labels.backupCodes ]]</strong></p>
                                <p class="cb-security__text">[[ labels.backupCodesExplain ]] [[ backupCodesCount ]]</p>
                                <ul class="cb-security__codes" v-if="security.codes">
                                    <li v-for="code in security.codes" :key="code"><code>[[ code ]]</code></li>
                                </ul>
                                <p class="cb-notice" v-if="security.codes">[[ labels.backupCodesOnce ]]</p>
                                <button type="button" class="cb-button" @click="generateBackupCodes()" :disabled="loading">[[ labels.backupCodesGenerate ]]</button>
                            </div>
                            <div class="cb-security__step">
                                <p><strong>[[ labels.twoFactorDisableTitle ]]</strong></p>
                                <button type="button" class="cb-button" v-if="!security.confirmDisable" @click="security.confirmDisable = true">[[ labels.twoFactorDisable ]]</button>
                                <span v-else>
                                    <span class="cb-security__text">[[ labels.twoFactorDisableConfirm ]]</span>
                                    <button type="button" class="cb-button cb-button--danger" @click="disableTwoFactor()" :disabled="loading">[[ labels.twoFactorDisableYes ]]</button>
                                    <button type="button" class="cb-button" @click="security.confirmDisable = false">[[ labels.cancel ]]</button>
                                </span>
                            </div>
                        </div>

                        {# Delete the account with all data, confirmed with the password #}
                        <p class="cb-form__title cb-security__danger"><strong>[[ labels.accountDeleteTitle ]]</strong></p>
                        <div class="cb-security__step">
                            <p class="cb-security__text">[[ labels.accountDeleteExplain ]]</p>
                            <button type="button" class="cb-button cb-button--danger" v-if="!account.confirm" @click="account.confirm = true">[[ labels.accountDelete ]]</button>
                            <form v-else @submit.prevent="deleteAccount()">
                                <div class="cb-field" :class="{'cb-field--error': account.error}">
                                    <label for="cb-account-password">[[ labels.accountDeletePassword ]]</label>
                                    <input type="password" id="cb-account-password" v-model="account.password" autocomplete="current-password" required>
                                    <span class="cb-field__error" v-if="account.error">[[ accountError ]]</span>
                                </div>
                                <div class="cb-form__actions">
                                    <button type="submit" class="cb-button cb-button--danger" :disabled="loading || !account.password">[[ labels.accountDeleteYes ]]</button>
                                    <button type="button" class="cb-button" @click="resetAccount()">[[ labels.cancel ]]</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <p class="cb-message" v-if="loading && !master">[[ labels.loading ]]</p>

                {# Timetable editor #}
                <div v-if="master && resource === 'lesson'" :class="{'cb-timetable--loading': loading}">
                    <p class="cb-message" v-if="!master.data.schoolYear.length">[[ labels.noSchoolYear ]]</p>
                    <p class="cb-message" v-else-if="!master.data.period.length">[[ labels.noPeriods ]]</p>
                    <div v-else>
                        <div class="cb-field cb-field--inline">
                            <label for="cb-timetable-year">[[ labels.fields.schoolYear ]]</label>
                            <select id="cb-timetable-year" v-model="timetableYear" @change="lessonForm = null">
                                <option v-for="year in master.data.schoolYear" :key="year.id" :value="year.id">[[ year.title ]]</option>
                            </select>
                            <button type="button" class="cb-button cb-nav__weekend" :class="{'cb-nav__weekend--on': weekend}" @click="toggleWeekend()" :aria-pressed="weekend ? 'true' : 'false'" :title="weekend ? labels.weekendHide : labels.weekendShow">[[ labels.weekend ]]</button>
                        </div>

                        <p class="cb-message">[[ labels.timetableHint ]]</p>

                        <div class="cb-scroll">
                            <table class="cb-timetable cb-timetable--edit">
                                <thead>
                                    <tr>
                                        <th class="cb-timetable__period"></th>
                                        <th v-for="weekday in editorWeekdays" :key="weekday">[[ weekdayName(weekday) ]]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr v-for="row in editorGrid" :key="row.period.id">
                                        <th class="cb-timetable__period">
                                            <strong>[[ row.period.number ]]</strong>
                                            <span>[[ row.period.startTime ]]&ndash;[[ row.period.endTime ]]</span>
                                        </th>
                                        <td v-for="cell in row.cells" :key="cell.weekday">
                                            <button type="button" class="cb-slot" :class="{'cb-slot--active': cell.active}" @click="openLesson(cell.weekday, row.period, cell.lesson)" :aria-label="slotLabel(cell.weekday, row.period)">
                                                <span class="cb-lesson" v-if="cell.lesson" :style="cell.lesson.style" :title="cell.lesson.tooltip">
                                                    <strong>[[ cell.lesson.shortTitle ]]</strong>
                                                </span>
                                                <span class="cb-slot__add" v-else aria-hidden="true">+</span>
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <form class="cb-form" v-if="lessonForm" @submit.prevent="saveLesson()" novalidate>
                            <p class="cb-form__title">
                                <strong>[[ lessonForm.id ? labels.editLesson : labels.newLesson ]]:</strong> [[ slotLabel(lessonForm.weekday, lessonForm.period) ]]
                                <span class="cb-field__error" v-if="lessonForm.errors.period">[[ lessonError('period') ]]</span>
                            </p>
                            <div class="cb-field" :class="{'cb-field--error': lessonForm.errors.subject}">
                                <label for="cb-lesson-subject">[[ labels.fields.subject ]]</label>
                                <select id="cb-lesson-subject" v-model="lessonForm.data.subject">
                                    <option value="">[[ labels.pleaseSelect ]]</option>
                                    <option v-for="subject in master.data.subject" :key="subject.id" :value="subject.id">[[ subject.title ]]</option>
                                </select>
                                <span class="cb-field__error" v-if="lessonForm.errors.subject">[[ lessonError('subject') ]]</span>
                            </div>
                            <div class="cb-field" :class="{'cb-field--error': lessonForm.errors.learningGroup}">
                                <label for="cb-lesson-group">[[ labels.fields.learningGroup ]]</label>
                                <select id="cb-lesson-group" v-model="lessonForm.data.learningGroup">
                                    <option value="">[[ labels.pleaseSelect ]]</option>
                                    <option v-for="group in timetableGroups" :key="group.id" :value="group.id">[[ group.title ]]</option>
                                </select>
                                <span class="cb-field__error" v-if="lessonForm.errors.learningGroup">[[ lessonError('learningGroup') ]]</span>
                            </div>
                            <div class="cb-field" :class="{'cb-field--error': lessonForm.errors.room}">
                                <label for="cb-lesson-room">[[ labels.fields.room ]]</label>
                                <input id="cb-lesson-room" type="text" v-model="lessonForm.data.room" maxlength="32">
                                <span class="cb-field__error" v-if="lessonForm.errors.room">[[ lessonError('room') ]]</span>
                            </div>
                            <div class="cb-form__actions">
                                <button type="submit" class="cb-button cb-button--primary" :disabled="loading">[[ labels.save ]]</button>
                                <button type="button" class="cb-button" @click="lessonForm = null">[[ labels.cancel ]]</button>
                                <span class="cb-form__delete" v-if="lessonForm.id && lessonForm.confirmDelete">
                                    [[ labels.confirmDelete ]]
                                    <button type="button" class="cb-button cb-button--danger" @click="deleteLesson()" :disabled="loading">[[ labels.yes ]]</button>
                                    <button type="button" class="cb-button" @click="lessonForm.confirmDelete = false">[[ labels.no ]]</button>
                                </span>
                                <button type="button" class="cb-button cb-button--danger cb-form__delete" v-else-if="lessonForm.id" @click="lessonForm.confirmDelete = true">[[ labels.delete ]]</button>
                            </div>
                        </form>
                    </div>
                </div>

                {# Generic lists and forms of the other resources #}
                <div v-if="master && resource !== 'lesson' && resource !== 'security'" :class="{'cb-timetable--loading': loading}">
                    <table class="cb-table" v-if="records.length">
                        <thead>
                            <tr>
                                <th v-for="(field, name) in visibleFields" :key="name">[[ labels.fields[name] ]]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr v-for="record in records" :key="record.id" :class="{'cb-table__row--active': form && form.id === record.id}">
                                <td v-for="(field, name) in visibleFields" :key="name">
                                    <span class="cb-lesson cb-lesson--sample" v-if="field.type === 'color'" :style="{'--cb-lesson-color': record[name]}">[[ colorName(record[name], field, name) ]]</span>
                                    <span v-else>[[ formatValue(record[name], field, name) ]]</span>
                                </td>
                                <td class="cb-table__actions">
                                    <span v-if="deleteId === record.id">
                                        [[ labels.confirmDelete ]]
                                        <button type="button" class="cb-button cb-button--danger" @click="deleteRecord(record)" :disabled="loading">[[ labels.yes ]]</button>
                                        <button type="button" class="cb-button" @click="deleteId = null">[[ labels.no ]]</button>
                                    </span>
                                    <span v-else>
                                        <button type="button" class="cb-button" @click="openForm(record)">[[ labels.edit ]]</button>
                                        <button type="button" class="cb-button" @click="deleteId = record.id">[[ labels.delete ]]</button>
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <p class="cb-message" v-else>[[ labels.noRecords ]]</p>

                    <button type="button" class="cb-button cb-button--primary" v-if="!form" @click="openForm(null)">[[ labels.add ]]</button>

                    <form class="cb-form" v-if="form" @submit.prevent="saveRecord()" novalidate>
                        <div class="cb-field" v-for="(field, name) in visibleFields" :key="name" :class="{'cb-field--error': form.errors[name]}">
                            <label :for="'cb-field-' + name">[[ labels.fields[name] ]]</label>
                            <select v-if="field.type === 'reference'" :id="'cb-field-' + name" v-model="form.data[name]">
                                <option value="">[[ labels.pleaseSelect ]]</option>
                                <option v-for="option in referenceOptions(field)" :key="option.id" :value="option.id">[[ option.title ]]</option>
                            </select>
                            <select v-else-if="field.type === 'select'" :id="'cb-field-' + name" v-model="form.data[name]">
                                <option value="">[[ labels.pleaseSelect ]]</option>
                                <option v-for="option in field.options" :key="option" :value="option">[[ optionLabel(name, option) ]]</option>
                            </select>
                            <div v-else-if="field.type === 'references'" class="cb-checkboxes" :id="'cb-field-' + name">
                                <label v-for="option in referenceOptions(field)" :key="option.id">
                                    <input type="checkbox" :value="option.id" v-model="form.data[name]"> [[ option.title ]]
                                </label>
                                <span class="cb-field__hint" v-if="!referenceOptions(field).length">[[ labels.noOptions ]]</span>
                            </div>
                            <div v-else-if="field.type === 'color' && field.options" class="cb-swatches" role="radiogroup" :id="'cb-field-' + name" :aria-label="labels.fields[name]">
                                <label v-for="color in field.options" :key="color" class="cb-swatches__item" :title="optionLabel(name, color)">
                                    <input type="radio" :name="'cb-color-' + name" :value="color" v-model="form.data[name]" :aria-label="optionLabel(name, color)">
                                    <span :style="{'--cb-lesson-color': color}"></span>
                                </label>
                            </div>
                            <input v-else :id="'cb-field-' + name" :type="inputType(field)" v-model="form.data[name]" :maxlength="field.maxLength" :min="field.min" :max="field.max">
                            <span class="cb-field__error" v-if="form.errors[name]">[[ errorLabel(name) ]]</span>
                        </div>
                        {# Classroom: drag desks into the room #}
                        <div class="cb-roomedit" v-if="roomEditor">
                            <p class="cb-field__hint">[[ labels.roomHint ]]</p>
                            <div class="cb-roomedit__tools">
                                {# Spans, because Firefox does not start a drag from a button #}
                                <span class="cb-roomedit__type" v-for="type in deskTypes" :key="type" role="button" tabindex="0" draggable="true" @dragstart="onDeskTypeDragStart($event, type)" @click="addDesk(type, null)" @keydown.enter.prevent="addDesk(type, null)">
                                    <span class="cb-roomedit__icon" :class="'cb-roomedit__icon--' + type" aria-hidden="true"></span>
                                    [[ deskLabel(type) ]]
                                </span>
                                <button type="button" class="cb-button" @click="rotateDesk()" :disabled="!roomEditor.selected">[[ labels.roomRotate ]]</button>
                                <button type="button" class="cb-button" @click="removeDesk()" :disabled="!roomEditor.selected">[[ labels.roomRemove ]]</button>
                            </div>
                            <div class="cb-room cb-room--edit">
                                <div class="cb-room__board">[[ labels.roomBoard ]]</div>
                                <div class="cb-room__area" ref="room" @dragover.prevent @drop.prevent="onRoomDrop($event)" @pointerdown.self="roomEditor.selected = null">
                                    <div class="cb-desk" v-for="desk in editorDesks" :key="desk.id" tabindex="0" :class="deskClass(desk)" :style="desk.style" :aria-label="deskLabel(desk.type)" @pointerdown="onDeskPointerDown($event, desk)" @pointermove="onDeskPointerMove($event)" @pointerup="onDeskPointerUp()" @pointercancel="onDeskPointerUp()" @keydown="onDeskKey($event, desk)">
                                        <span class="cb-desk__label" v-if="desk.type === 'teacher'">[[ deskLabel('teacher') ]]</span>
                                        <span class="cb-seat" v-for="seat in desk.seats" :key="seat.key" :style="seat.style"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="cb-form__actions">
                            <button type="submit" class="cb-button cb-button--primary" :disabled="loading">[[ labels.save ]]</button>
                            <button type="button" class="cb-button" @click="form = null">[[ labels.cancel ]]</button>
                        </div>
                    </form>
                </div>
            </section>

            {# Dialog: create or edit an entry #}
            <div class="cb-overlay" v-if="entryForm">
                <form class="cb-dialog" role="dialog" aria-modal="true" aria-labelledby="cb-entry-title" @submit.prevent="saveEntry()" novalidate>
                    <button type="button" class="cb-dialog__close" @click="closeEntry()" :title="labels.close" :aria-label="labels.close"><cb-icon name="close"></cb-icon></button>
                    <h2 class="cb-dialog__title" id="cb-entry-title">[[ entryForm.id ? labels.editEntry : labels.newEntry ]]</h2>

                    <div class="cb-dialog__grid">
                        <div class="cb-field" :class="{'cb-field--error': entryForm.errors.type}">
                            <label for="cb-entry-type">[[ labels.fields.type ]]</label>
                            <select id="cb-entry-type" v-model="entryForm.data.type">
                                <option v-for="type in entryTypes" :key="type" :value="type">[[ optionLabel('type', type) ]]</option>
                            </select>
                            <span class="cb-field__error" v-if="entryForm.errors.type">[[ entryError('type') ]]</span>
                        </div>
                        <div class="cb-field" :class="{'cb-field--error': entryForm.errors.entryDate}">
                            <label for="cb-entry-date">[[ labels.fields.entryDate ]]</label>
                            <input id="cb-entry-date" type="date" v-model="entryForm.data.entryDate">
                            <span class="cb-field__error" v-if="entryForm.errors.entryDate">[[ entryError('entryDate') ]]</span>
                            <span class="cb-field__hint" v-else-if="entryForm.id">[[ labels.moveHint ]]</span>
                        </div>
                        <div class="cb-field" :class="{'cb-field--error': entryForm.errors.period}">
                            <label for="cb-entry-period">[[ labels.fields.period ]]</label>
                            <select id="cb-entry-period" v-model="entryForm.data.period">
                                <option value="">[[ labels.wholeDay ]]</option>
                                <option v-for="period in timetable.periods" :key="period.id" :value="period.id">[[ periodLabel(period) ]]</option>
                            </select>
                            <span class="cb-field__error" v-if="entryForm.errors.period">[[ entryError('period') ]]</span>
                        </div>
                        <div class="cb-field" v-if="!entryForm.data.period" :class="{'cb-field--error': entryForm.errors.entryTime}">
                            <label for="cb-entry-time">[[ labels.fields.entryTime ]]</label>
                            <input id="cb-entry-time" type="time" v-model="entryForm.data.entryTime">
                            <span class="cb-field__error" v-if="entryForm.errors.entryTime">[[ entryError('entryTime') ]]</span>
                        </div>
                    </div>

                    <div class="cb-field" v-if="entryForm.data.type === 'appointment'" :class="{'cb-field--error': entryForm.errors.location}">
                        <label for="cb-entry-location">[[ labels.fields.location ]]</label>
                        <input id="cb-entry-location" type="text" maxlength="128" v-model="entryForm.data.location">
                        <span class="cb-field__error" v-if="entryForm.errors.location">[[ entryError('location') ]]</span>
                    </div>

                    <div class="cb-field" :class="{'cb-field--error': entryForm.errors.content}">
                        <label for="cb-entry-content">[[ labels.fields.content ]]</label>
                        <textarea id="cb-entry-content" ref="entryContent" rows="5" maxlength="5000" v-model="entryForm.data.content"></textarea>
                        <span class="cb-field__error" v-if="entryForm.errors.content">[[ entryError('content') ]]</span>
                    </div>

                    <div class="cb-dialog__grid">
                        <label class="cb-check" v-if="'task' === entryForm.data.type"><input type="checkbox" v-model="entryForm.data.done"> [[ labels.fields.done ]]</label>
                        <label class="cb-check"><input type="checkbox" v-model="entryForm.data.important"> [[ labels.fields.important ]]</label>
                        <div class="cb-field" v-if="entryForm.data.important" :class="{'cb-field--error': entryForm.errors.visibleFrom}">
                            <label for="cb-entry-visible">[[ labels.fields.visibleFrom ]]</label>
                            <input id="cb-entry-visible" type="date" v-model="entryForm.data.visibleFrom">
                            <span class="cb-field__error" v-if="entryForm.errors.visibleFrom">[[ entryError('visibleFrom') ]]</span>
                        </div>
                    </div>

                    <div class="cb-field" :class="{'cb-field--error': entryForm.errors.reminder}">
                        <label for="cb-entry-reminder">[[ labels.fields.reminder ]]</label>
                        <select id="cb-entry-reminder" v-model="entryForm.data.reminder">
                            <option value="">[[ labels.noReminder ]]</option>
                            <option v-for="option in reminderOptions" :key="option" :value="option">[[ optionLabel('reminder', option) ]]</option>
                        </select>
                        <span class="cb-field__error" v-if="entryForm.errors.reminder">[[ entryError('reminder') ]]</span>
                        <span class="cb-field__hint" v-else-if="entryForm.data.reminder">[[ labels.reminderHint ]]</span>
                    </div>

                    <div class="cb-form__actions">
                        <button type="submit" class="cb-button cb-button--primary" :disabled="loading">[[ labels.save ]]</button>
                        <span class="cb-form__delete" v-if="entryForm.id && entryForm.confirmDelete">
                            [[ labels.confirmDelete ]]
                            <button type="button" class="cb-button cb-button--danger" @click="deleteEntry()" :disabled="loading">[[ labels.yes ]]</button>
                            <button type="button" class="cb-button" @click="entryForm.confirmDelete = false">[[ labels.no ]]</button>
                        </span>
                        <button type="button" class="cb-button cb-button--danger cb-form__delete" v-else-if="entryForm.id" @click="entryForm.confirmDelete = true">[[ labels.delete ]]</button>
                    </div>
                </form>
            </div>

            {# Dialog: tasks of previous days that are not done #}
            <div class="cb-overlay" v-if="openEntries && !entryForm">
                <div class="cb-dialog" role="dialog" aria-modal="true" aria-labelledby="cb-open-title">
                    <button type="button" class="cb-dialog__close" @click="openEntries = null" :title="labels.close" :aria-label="labels.close"><cb-icon name="close"></cb-icon></button>
                    <h2 class="cb-dialog__title" id="cb-open-title">[[ labels.openTitle ]]</h2>
                    <p class="cb-message" v-if="!openEntries.length">[[ labels.noOpenEntries ]]</p>
                    <ul class="cb-open" v-else>
                        <li v-for="entry in openEntries" :key="entry.id">
                            <input type="checkbox" :checked="entry.done" @change="toggleDone(entry)" :aria-label="labels.fields.done" :title="labels.fields.done">
                            <span class="cb-open__date">[[ formatDate(entry.entryDate) ]]</span>
                            <span class="cb-open__text">[[ entry.content ]]</span>
                            <button type="button" class="cb-button" @click="openEntry(entry)">[[ labels.move ]]</button>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <noscript><p class="cb-message">{{ 'MSC.classBook.noScript'|trans }}</p></noscript>

        {% add "class_book_css" to head %}
            <link rel="stylesheet" href="{{ asset('css/class-book.css', 'markocupic_contao_class_book') }}">
        {% endadd %}
        {% add "class_book_vue_js" to body %}
            <script src="{{ asset('vue/vue.global.prod.js', 'markocupic_contao_class_book') }}"></script>
        {% endadd %}
        {% add "class_book_icons_js" to body %}
            <script src="{{ asset('js/class-book-icons.js', 'markocupic_contao_class_book') }}"></script>
        {% endadd %}
        {% add "class_book_js" to body %}
            <script src="{{ asset('js/class-book.js', 'markocupic_contao_class_book') }}"></script>
        {% endadd %}
    {% endif %}
{% endblock %}
